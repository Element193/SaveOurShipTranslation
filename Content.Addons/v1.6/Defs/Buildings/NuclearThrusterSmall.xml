<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingShipBase">
		<defName>Ship_NuclearEngineSmall</defName>
		<label>small nuclear engine</label>
		<designatorDropdown>Ship_Engines</designatorDropdown>
		<thingClass>Building</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Ship/NuclearEngineSmall</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(5.13,7)</drawSize>
		</graphicData>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<researchPrerequisites>
			<li>ShipEngine</li>
			<li>ShipReactor</li>
		</researchPrerequisites>
		<statBases>
			<WorkToBuild>60000</WorkToBuild>
			<MaxHitPoints>1800</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<description>A small nuclear-powered engine capable of launching a ship into orbit. Not suitable for interplanetary travel.\n\n&lt;color=#bb8f04&gt;Thrust: 4000kH\nFuel use: 2 fuel pods/s&lt;/color&gt;</description>
		<size>(3,5)</size>
		<receivesSignals>true</receivesSignals>
		<designationCategory>Ship</designationCategory>
		<comps>
			<li Class="SaveOurShip2.CompProps_ShipCachePart">
				<hermetic>true</hermetic>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>80</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Refuelable">
				<fuelCapacity>1600.0</fuelCapacity>
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<fuelFilter>
					<thingDefs>
						<li>ShuttleFuelPods</li>
					</thingDefs>
				</fuelFilter>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<autoRefuelPercent>0.9</autoRefuelPercent>
				<showFuelGizmo>false</showFuelGizmo>
				<drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
				<drawFuelGaugeInMap>false</drawFuelGaugeInMap>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
			<li Class="SaveOurCat.CompProps_NuclearThrusterSmall">
				<!--graphicData>
					<texPath>Things/Building/Ship/NuclearEngineTrail</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>(7,26.5)</drawSize>
				</graphicData-->
				<thrust>4</thrust>
				<fuelUse>2</fuelUse>
				<takeOff>true</takeOff>
				<killZoneLength>10</killZoneLength>
				<killZoneWidth>7</killZoneWidth>
				<soundWorking>ShipEngineFuel</soundWorking>
			</li>
		</comps>
		<placeWorkers>
			<li>SaveOurShip2.PlaceWorker_ShipEngine</li>
		</placeWorkers>
		<building>
			<isAirtight>true</isAirtight>
			<shipPart>true</shipPart>
		</building>
		<costList>
			<Steel>220</Steel>
			<Plasteel>80</Plasteel>
			<ComponentSpacer>6</ComponentSpacer>
		</costList>
		<designationHotKey>Misc5</designationHotKey>
	</ThingDef>
</Defs>
