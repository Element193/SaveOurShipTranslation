<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingShipBase">
		<defName>Ship_AntiprotoniumThruster</defName>
		<label>antiproton thruster</label>
		<designatorDropdown>Ship_Engines</designatorDropdown>
		<thingClass>Building</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Ship/AntiProton_Thruster</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1.375,3.1)</drawSize>
		</graphicData>
		<uiIconScale>0.55</uiIconScale>
		<altitudeLayer>Building</altitudeLayer>
		<researchPrerequisites>
			<li>AcceleratingParticles</li>
		</researchPrerequisites>
		<statBases>
			<WorkToBuild>15000</WorkToBuild>
			<MaxHitPoints>800</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<description>A compact antiprotonium thruster from advanced worlds. Have a small fuel tank and can provide fast acceleration in a short time. Used for quickly avoiding possible threats or approaching in battles.\n\n&lt;color=#bb8f04&gt;Thrust: 4200 kH.\nNot suitable for interstellar travel.&lt;/color&gt;</description>
		<size>(1,3)</size>
		<receivesSignals>true</receivesSignals>
		<designationCategory>Ship</designationCategory>
		<comps>
			<li Class="SaveOurShip2.CompProps_ShipCachePart">
				<hermetic>true</hermetic>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>15</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Refuelable">
				<fuelCapacity>45</fuelCapacity>
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<fuelFilter>
					<thingDefs>
						<li>AntiprotoniumPod</li>
					</thingDefs>
				</fuelFilter>
				<autoRefuelPercent>0</autoRefuelPercent>
				<showFuelGizmo>false</showFuelGizmo>
				<drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
				<drawFuelGaugeInMap>false</drawFuelGaugeInMap>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
			<li Class="SaveOurShip2.CompProps_EngineTrail">
				<preciseThrust>4.2</preciseThrust>
				<fuelUse>2</fuelUse>
				<takeOff>true</takeOff>
				<killZoneLength>9</killZoneLength>
				<killZoneWidth>1</killZoneWidth>
				<soundWorking>ShipEngineFuel</soundWorking>
			</li>
		</comps>
		<building>
			<isAirtight>true</isAirtight>
			<shipPart>true</shipPart>
			<paintable>true</paintable>
		</building>
		<costList>
			<Steel>120</Steel>
			<Plasteel>50</Plasteel>
			<ComponentSpacer>6</ComponentSpacer>
		</costList>
	</ThingDef>

