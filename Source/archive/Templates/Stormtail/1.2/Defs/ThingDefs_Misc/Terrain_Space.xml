<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="RockBase">
    <defName>MineableArchonite</defName>
    <label>Archonite Ore</label>
    <description>This piece of rock seems to have mutated into a crystalline structure. Within it's transluscent shell one can see "Things" moving around.</description>
    <graphicData>
      <texPath>Things/Terrain/Archonite_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <colorTwo>(31,31,31)</colorTwo>
      <color>(128,128,128)</color>
    </graphicData>
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>4</glowRadius>
				<glowColor>(152,209,76,0)</glowColor>
			</li>
		</comps>	
    <statBases>
      <MaxHitPoints>9000</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>Archonite</mineableThing>
      <mineableYield>1000</mineableYield>
      <mineableScatterCommonality>0.2</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>150~350</mineableScatterLumpSizeRange>
    </building>
  </ThingDef>
  
  <ThingDef ParentName="ResourceBase">
    <defName>Archonite</defName>
    <label>Archonite Ore</label>
    <description>A strange crystal which inner structure seems to be constantly moving. It even changes it's outer shape and color in your hand!</description>
    <graphicData>
      <texPath>Things/Terrain/Archonite</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>2</glowRadius>
				<glowColor>(152,209,76,0)</glowColor>
			</li>
		</comps>	
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <useHitPoints>true</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <stackLimit>750</stackLimit>	
    <statBases>
	  <MaxHitPoints>9000</MaxHitPoints>
	  <Flammability>0.8</Flammability>
      <MarketValue>0.1</MarketValue>
      <Mass>0.008</Mass>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <deepCommonality>2</deepCommonality>
    <deepCountPerPortion>50</deepCountPerPortion>
    <deepLumpSizeRange>200~300</deepLumpSizeRange>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
  </ThingDef>  

        <TerrainDef ParentName="TerrainRoadBase">
    <defName>AscendedCracks</defName>
    <label>Cracked Ascended Archonite</label>
    <description>You might not want to touch this....</description>	
    <texturePath>Things/Terrain/Surfaces/CrackedAscendedArchonite</texturePath>
    <edgeType>Fade</edgeType>
    <renderPrecedence>340</renderPrecedence>
    <pathCost>95</pathCost>	
	 <layerable>true</layerable>
    <costList>
      <Steel>1</Steel>
    </costList>	
    <!--<designationCategory>ShipDesign</designationCategory>-->	
    <resourcesFractionWhenDeconstructed>0.4</resourcesFractionWhenDeconstructed>
    <statBases>
      <Beauty>30</Beauty>
      <Cleanliness>30</Cleanliness>
    </statBases>
    
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
    
    </affordances>
    
    <fertility>0.0</fertility>

  </TerrainDef>  
  
