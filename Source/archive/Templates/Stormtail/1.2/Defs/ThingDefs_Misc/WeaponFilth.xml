<Defs>


  <ThingDef ParentName="BaseFilth">
    <defName>Filth_ArchoAcid</defName>
    <label>Archo Acid Puddle</label>
	<description>A puddle of sticky, moving noxious liquid.</description>
    <statBases>
      <Beauty>-80</Beauty>
      <Cleanliness>-15</Cleanliness>
    </statBases>
    <graphicData>
      <texPath>Things/Filth/ArchoSpatter</texPath>
      <!--<color>(100, 152, 100, 170)</color>-->
    </graphicData>
	<pathCost>80</pathCost>
    <filth>
      <rainWashes>true</rainWashes>
      <cleaningWorkToReduceThickness>90</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
	  <maxThickness>4</maxThickness>
    </filth>
  </ThingDef>
  
