<Defs>

	<ThingDef ParentName="MedicineBase">
		<defName>Spacermeds</defName>
		<label>Spacetech Medicine</label>
		<description>Ultra-advanced medical supplies made from spacetechnology. These are required for more advanced diseases, though are less effective than it's upgrade!</description>
		<thingClass>Medicine</thingClass>	
		<graphicData>
			<texPath>Things/Items/MedicineSpacer</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.85</drawSize>
		</graphicData>
		<techLevel>Ultra</techLevel>
		<statBases>
			<MarketValue>1000</MarketValue>
			<Mass>0.50</Mass>
			<Flammability>0.1</Flammability>
			<MedicalPotency>4.00</MedicalPotency>
			<MedicalQualityMax>4.50</MedicalQualityMax>
			<DeteriorationRate>0.0</DeteriorationRate>
			<WorkToMake>3000</WorkToMake>
		</statBases>
		<costList>
			<MedicineUltratech>2</MedicineUltratech>
			<Luciferium>2</Luciferium>
		</costList>
		<stackLimit>75</stackLimit>
        <generateCommonality>0</generateCommonality>
        <generateAllowChance>0</generateAllowChance>			
    <researchPrerequisites>
      <li>MedicalTreatment</li>
    </researchPrerequisites>		
