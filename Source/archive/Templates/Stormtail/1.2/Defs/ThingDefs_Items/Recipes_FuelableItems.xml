<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
  <RecipeDef>
    <defName>MakeArchoPods</defName>
    <label>make Archomatter fuel pods</label>
    <description>Craft 100 Archomatter fuel pods.</description>
    <jobString>Making Archomatter fuel pods.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <workAmount>6000</workAmount>
    <targetCountAdjustment>5</targetCountAdjustment>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Archomatter</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
			<li>
				<filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>5</count>
			</li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Archomatter</li>
		<li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ArchomatterPods>100</ArchomatterPods>
    </products>
    <workSkill>Crafting</workSkill>
	<recipeUsers>
		<li>ArchotechWorkbench</li>
	</recipeUsers>
  </RecipeDef>
  
