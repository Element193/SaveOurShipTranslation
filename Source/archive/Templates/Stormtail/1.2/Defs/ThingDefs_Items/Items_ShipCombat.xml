<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ShipTorpedoBase">
    <defName>ShipTorpedo_AntiTon</defName>
    <label>Antiton Torpedo</label>
    <description>A torpedo tipped with an anti-ton warhead and an advanced thruster. Can be fired from torpedo tubes. Multiple explosions when released. Range:200 DMG:(V.High)Anti Everything</description>
    <graphicData>
      <texPath>Things/Items/ShipTorpedoAntiTon</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
        <generateCommonality>0</generateCommonality>
        <generateAllowChance>0</generateAllowChance>	
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>35.9</explosiveRadius>
        <explosiveDamageType>BombSuper</explosiveDamageType>
        <explosiveExpandPerStackcount>0.8</explosiveExpandPerStackcount>
        <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
        <chanceToStartFire>0.22</chanceToStartFire>
        <damageFalloff>true</damageFalloff>
        <explosionEffect>GiantExplosion</explosionEffect>
        <explosionSound>Explosion_GiantBomb</explosionSound>
        <wickTicks>60~120</wickTicks>
      </li>
    </comps>
    <statBases>
      <MarketValue>3000</MarketValue>
    </statBases>
    <projectileWhenLoaded>Bullet_FakeAntiTon</projectileWhenLoaded>
    <costList>
      <Steel>60</Steel>
      <Chemfuel>80</Chemfuel>
	  <ComponentIndustrial>7</ComponentIndustrial>
	  <Shell_AntigrainWarhead>3</Shell_AntigrainWarhead>
    </costList>
    <tradeability>None</tradeability>	
    <recipeMaker>
      <researchPrerequisite>ShipTorpedoes</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
  
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_FakeAntiTon</defName>
    <label>antiton torpedo</label>
    <graphicData>
      <texPath>Things/Projectile/ShipTorpedoAntiTon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
	  <drawSize>(4,4)</drawSize>
    </graphicData>
    <thingClass>Bullet</thingClass>
    <projectile>
      <damageDef>BombSuper</damageDef>
      <!-- damage amount is the damage def default -->
      <speed>81</speed>
      <explosionRadius>0</explosionRadius>
      <flyOverhead>true</flyOverhead>
      <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
    </projectile>
	<interactionCellIcon>Bullet_Torpedo_AntiTon</interactionCellIcon> <!-- This is such a horrible kludge, but it's a way to attach a ThingDef to another ThingDef!-->
  </ThingDef>
  
  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>Bullet_Torpedo_AntiTon</defName>
    <label>antiton torpedo</label>
    <thingClass>Projectile_ExplosiveShipCombatAntigrain</thingClass>
    <graphicData>
      <texPath>Things/Projectile/ShipTorpedoAntiTon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
	  <drawSize>(4,4)</drawSize>
    </graphicData>
    <projectile>
      <explosionRadius>20</explosionRadius>
      <damageDef>ShipTorpedoBombSuper</damageDef>
      <speed>90</speed>
    </projectile>
