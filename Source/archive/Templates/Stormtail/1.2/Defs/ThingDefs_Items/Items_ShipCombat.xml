  </DamageDef>
  
  <ThingDef ParentName="ShipTorpedoBase">
    <defName>ShipTorpedo_Archlite</defName>
    <label>Archlite Torpedo</label>
    <description>A torpedo tipped with an Archomatter warhead, the dealiest weapon in existance! Extremely slow but will cause an Archonuclear explosion annihilating ANYTHING it touches! Can be fired from torpedo tubes. Explodes when damaged. Range:200 DMG:(Ludicrous)Leaves nothing alive</description>
    <graphicData>
      <texPath>Things/Items/ShipTorpedoArchlite</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
        <generateCommonality>0</generateCommonality>
        <generateAllowChance>0</generateAllowChance>	
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>6.9</explosiveRadius>
        <explosiveDamageType>BombSuper</explosiveDamageType>
        <explosiveExpandPerStackcount>4.8</explosiveExpandPerStackcount>
        <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
        <chanceToStartFire>3.22</chanceToStartFire>
        <damageFalloff>true</damageFalloff>
        <explosionEffect>GiantExplosion</explosionEffect>
        <explosionSound>ExplosionArchonuclear</explosionSound>
        <wickTicks>60~120</wickTicks>
      </li>
    </comps>
    <statBases>
      <MarketValue>200000</MarketValue>
    </statBases>
    <projectileWhenLoaded>Bullet_Archlite</projectileWhenLoaded>
    <costList>
      <Steel>100</Steel>
      <Chemfuel>1000</Chemfuel>
	  <ComponentIndustrial>2</ComponentIndustrial>
	  <Archomatter>200</Archomatter>
    </costList>
    <tradeability>None</tradeability>	
    <recipeMaker>
      <researchPrerequisite>ArchomatterResearch</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
  
