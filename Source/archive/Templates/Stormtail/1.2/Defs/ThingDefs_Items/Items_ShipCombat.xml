  	<SoundDef>
    <defName>ExplosionArchonuclear</defName>
    <context>MapOnly</context>
    <maxSimultaneous>6</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Ship/Archonuclear</clipPath>
          </li>
        </grains>
        <pitchRange>0.99~1.01</pitchRange>
        <volumeRange>525~525</volumeRange>
      </li>
    </subSounds>
  </SoundDef>
  
  <DamageDef>
    <defName>CoreBlast</defName>
    <label>CoreBlast</label>
    <workerClass>DamageWorker_Flame</workerClass>
    <externalViolence>true</externalViolence>
    <isExplosive>true</isExplosive>
    <deathMessage>{0} has been desintegrated.</deathMessage>
    <hediff>Shredded</hediff>
    <hediffSolid>Crack</hediffSolid>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <!--<impactSoundType>Blunt</impactSoundType>-->
    <armorCategory>Blunt</armorCategory>
    <minDamageToFragment>99999</minDamageToFragment>
    <defaultDamage>999999</defaultDamage>
    <buildingDamageFactor>9</buildingDamageFactor>
    <plantDamageFactor>9</plantDamageFactor>
    <explosionAffectOutsidePartsOnly>false</explosionAffectOutsidePartsOnly>
    <explosionHeatEnergyPerCell>2</explosionHeatEnergyPerCell>
    <explosionCellMote>Mote_ArchoNuclear</explosionCellMote>
    <soundExplosion>ExplosionArchonuclear</soundExplosion>
  </DamageDef> 

    <ThingDef ParentName="MoteBase">
    <defName>Mote_ArchoNuclear</defName>
    <graphicData>
      <texPath>Things/Mote/BlastArchonuclear</texPath>
      <shaderType>MoteGlow</shaderType>
	       <drawSize>8.2</drawSize>	  
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.42</fadeInTime>
      <solidTime>0.90</solidTime>
      <fadeOutTime>0.2</fadeOutTime>
      <growthRate>0.42</growthRate>
    </mote>
  </ThingDef> 

