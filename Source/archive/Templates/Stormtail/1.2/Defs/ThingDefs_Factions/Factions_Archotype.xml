<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef Name="AwakenedFactionBase" Abstract="True">
    <startingGoodwill>0</startingGoodwill>
    <naturalColonyGoodwill>5~0</naturalColonyGoodwill>  
    <goodwillDailyGain>0.0</goodwillDailyGain>
    <goodwillDailyFall>0.0</goodwillDailyFall>
  </FactionDef>

  <FactionDef Parent="AwakenedFactionBase">
    <defName>Awakened</defName>
    <label>The Awakened</label>
    <description>An unknown group driven mad by a strange source of energy.</description>
    <pawnSingular>Awakened</pawnSingular>
    <pawnsPlural>Awakened</pawnsPlural>
    <listOrderPriority>999</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>2</requiredCountAtGameStart>
    <maxCountAtGameStart>5</maxCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Scion</leaderTitle>
    <factionIconPath>UI/Awakened_Icon</factionIconPath>
    <colorSpectrum>
      <li>(209, 255, 51)</li>
      <li>(224, 255, 119)</li>
    </colorSpectrum>
    <permanentEnemy>false</permanentEnemy>
    <factionNameMaker>NamerFactionPirate</factionNameMaker>
    <settlementNameMaker>NamerSettlementPirate</settlementNameMaker>
    <techLevel>Archotech</techLevel>
    <backstoryFilters>
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
      </li>
    </backstoryFilters>
    <geneticVariance>0.8</geneticVariance>
    <hairTags>
      <li>Tribal</li>
    </hairTags>
    <allowedArrivalTemperatureRange>-275~1000</allowedArrivalTemperatureRange>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,700)</li>
        <li>(700, 5000)</li>
        <li>(5000, 9000)</li>
        <li>(9000, 20000)</li>
        <li>(20000, 30000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <!-- Normal fights, ranged with melee mix-ins -->
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <Drifter>10</Drifter>
          <Thrasher>3</Thrasher>
          <Scavenger>10</Scavenger>
          <Pirate>10</Pirate>
          <Grenadier_EMP>0.25</Grenadier_EMP>
          <Grenadier_Smoke>0.25</Grenadier_Smoke>
          <Grenadier_Destructive>2</Grenadier_Destructive>
          <AwakenedGunner>10</AwakenedGunner>
          <Mercenary_Heavy>6</Mercenary_Heavy>
          <Mercenary_Slasher>3</Mercenary_Slasher>
          <Mercenary_Sniper>7</Mercenary_Sniper>
          <Mercenary_Elite>10</Mercenary_Elite>
          <PirateBoss>2</PirateBoss>
        </options>
      </li>
      <li>
        <!-- Normal fights, melee-only -->
        <kindDef>Combat</kindDef>
        <commonality>30</commonality>
        <disallowedStrategies>
          <li>Siege</li>
        </disallowedStrategies>
        <options>
          <AwakenedTrasher>5</AwakenedTrasher>
          <Mercenary_Slasher>2</Mercenary_Slasher>
          <PirateBoss>1</PirateBoss>
        </options>
      </li>
      <li>
        <!-- Normal fights, ranged only -->
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <Scavenger>10</Scavenger>
          <Pirate>10</Pirate>
          <Grenadier_EMP>0.25</Grenadier_EMP>
          <Grenadier_Smoke>0.25</Grenadier_Smoke>
          <Grenadier_Destructive>2</Grenadier_Destructive>
          <AwakenedGunner>10</AwakenedGunner>
          <Mercenary_Heavy>6</Mercenary_Heavy>
          <Mercenary_Sniper>7</Mercenary_Sniper>
          <PirateBoss>2</PirateBoss>
        </options>
      </li>
      <li>
        <!-- Normal fights, explosives with ranged mix-ins -->
        <kindDef>Combat</kindDef>
        <commonality>15</commonality>
        <disallowedStrategies>
          <li>Siege</li>
        </disallowedStrategies>
        <options>
          <Grenadier_EMP>0.5</Grenadier_EMP>
          <Grenadier_Smoke>0.5</Grenadier_Smoke>
          <Grenadier_Destructive>10</Grenadier_Destructive>
          <AwakenedGunner>12</AwakenedGunner>
          <AwakenedTrasher>5</AwakenedTrasher>
          <Mercenary_Elite>1</Mercenary_Elite>
          <PirateBoss>1</PirateBoss>
        </options>
      </li>
      <li>
        <!-- Base defense, mainly ranged with melee mix-ins -->
        <kindDef>Settlement</kindDef>
        <options>
          <AwakenedTrasher>5</AwakenedTrasher>
          <Pirate>2</Pirate>
          <Grenadier_Destructive>2</Grenadier_Destructive>
          <Mercenary_Slasher>3</Mercenary_Slasher>
          <Mercenary_Sniper>3</Mercenary_Sniper>
          <AwakenedGunner>20</AwakenedGunner>
          <Mercenary_Elite>10</Mercenary_Elite>
          <PirateBoss>3</PirateBoss>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>UI/Awakened_Icon</settlementTexturePath>
  </FactionDef>

</Defs>