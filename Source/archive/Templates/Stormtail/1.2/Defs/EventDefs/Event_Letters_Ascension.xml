<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <LetterDef>
    <defName>ArchoAscension</defName><!-- For second to last Research -->
    <color>(20, 247, 151 )</color>
    <flashColor>(117, 250, 194 )</flashColor>
    <flashInterval>0.01</flashInterval>
    <arriveSound>AscensionWarning</arriveSound>
  </LetterDef>
  
  <LetterDef>
    <defName>ArchoDeath</defName><!-- For Final Research -->
