  	<SoundDef>
    <defName>MassiveLaserCharge</defName>
    <context>MapOnly</context>
    <sustain>True</sustain>  	
    <maxSimultaneous>3</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <onCamera>True</onCamera>		  
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Other/MassiveLaserCharge</clipPath>
          </li>
        </grains>
        <pitchRange>0.99~1.01</pitchRange>
        <volumeRange>525~525</volumeRange>
        <sustainIntervalRange>0.5~0.5</sustainIntervalRange>		
        <sustainLoop>False</sustainLoop> 		
      </li>
    </subSounds>
  </SoundDef>   

  	<SoundDef>
    <defName>MassiveLaser</defName>
    <context>MapOnly</context>
    <sustain>True</sustain>	
    <maxSimultaneous>3</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <onCamera>True</onCamera>		  
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Other/MassiveLaser</clipPath>
          </li>
        </grains>
        <pitchRange>0.99~1.01</pitchRange>
        <volumeRange>525~525</volumeRange>
        <sustainIntervalRange>0.10~0.10</sustainIntervalRange>		
        <sustainLoop>False</sustainLoop>		
      </li>
    </subSounds>
  </SoundDef>     
  
 </Defs>