<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <LetterDef>
    <defName>ArchoGood</defName><!-- Good Letters -->
    <color>(135, 180, 255)</color>
    <flashColor>(115, 255, 210)</flashColor>
    <flashInterval>0.01</flashInterval>
    <arriveSound>LetterGood</arriveSound>
  </LetterDef>

  <LetterDef>
    <defName>Archobad</defName><!-- Bad Letters -->
    <color>(250, 247, 53)</color>
    <flashColor>(252, 251, 148)</flashColor>
    <flashInterval>0.01</flashInterval>
    <arriveSound>LetterBad</arriveSound>
  </LetterDef>

  <LetterDef>
    <defName>ArchoWhat</defName><!-- Weird Letters -->
    <color>(143, 245, 27 )</color>
    <flashColor>(207, 249, 160 )</flashColor>
    <flashInterval>0.01</flashInterval>
    <arriveSound>LetterWTF</arriveSound>
  </LetterDef>
  
  
     	<SoundDef>
    <defName>LetterWTF</defName>	
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>	
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <onCamera>True</onCamera>	  
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Ship/LetterWTF</clipPath>
          </li>
        </grains>
        <!--<pitchRange>0.2~0.8</pitchRange>-->
        <volumeRange>525~525</volumeRange>
      </li>
    </subSounds>
  </SoundDef>

