<Defs>

  <ThingDef ParentName="BaseShipArtilleryBuilding">
    <defName>ShipTurret_RailArtillery</defName>
    <label>Railgun Artillery</label>
    <description>Two rail-powered tungsten coated slugs are fired from this rather beastly weapon. Though a more conventional ballistic it packs quite the punch. Range:100Max-50Min Heat:100PP Energy:5PP DMG:(Medium)Good against hull. Bad against shields.</description>
    <graphicData>
      <texPath>Things/Building/Ship/HardpointStandard</texPath>
    </graphicData>	
    <comps>
      <li Class="CompProperties_ShipHeat">
        <compClass>CompShipHeatSource</compClass>
		<heatPerPulse>100</heatPerPulse>
		<energyToFire>5</energyToFire>
		<maxRange>100</maxRange>
		<minRange>50</minRange>
		<projectileSpeed>4</projectileSpeed>
		<threat>35</threat>		
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <building>
      <turretGunDef>ShipTurret_RailArtilleryTop</turretGunDef>
      <buildingTags>
      </buildingTags>
      <turretBurstWarmupTime>0.0</turretBurstWarmupTime>
      <turretBurstCooldownTime>10.0</turretBurstCooldownTime>
      <turretTopDrawSize>3</turretTopDrawSize>
    </building>
    <costList>
	  <Steel>150</Steel>
      <Uranium>250</Uranium>
	  <Plasteel>50</Plasteel>
      <ComponentSpacer>5</ComponentSpacer>
    </costList>
    <designationCategory>SoS2Ex</designationCategory>	
  <uiIconPath>Things/Building/Ship/RailArtilleryMenu</uiIconPath>
    <researchPrerequisites>
      <li>ShipTurretKinetic</li>
    </researchPrerequisites>
    <altitudeLayer>WorldClipper</altitudeLayer>
  </ThingDef>
  
  <ThingDef ParentName="BaseShipArtilleryWeapon">
    <defName>ShipTurret_RailArtilleryTop</defName>
    <label>Rail Artillery</label>
    <description>Railgun Artillery.</description>
    <graphicData>
      <texPath>Things/Building/Ship/RailArtillery</texPath>
    </graphicData>
    <weaponTags>
    </weaponTags>
    <verbs>
      <li>
        <label>shoot slug</label>
        <verbClass>Verb_LaunchProjectileShip</verbClass>
