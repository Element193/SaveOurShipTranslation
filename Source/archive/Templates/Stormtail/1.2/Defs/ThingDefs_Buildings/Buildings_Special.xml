<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>BioHive</defName>
    <label>Archogenetic Hive (The Build-A-Bug)</label>
    <description>A strange building fed with Archomatter to reconstruct certain beasties. (A new kind of biological basedefense. These little guys will protect you!)</description>
    <thingClass>Hive</thingClass>
    <graphicData>
      <texPath>Things/Building/Ship/Buildabug</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>3.6</drawSize>
    </graphicData>
	<size>3,3</size>	
    <researchPrerequisites>
      <li>ArchoReconstruction</li>
    </researchPrerequisites>
    <uiIconScale>0.35</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <Flammability>0.0</Flammability>
    </statBases>
    <pathCost>50</pathCost>
    <receivesSignals>true</receivesSignals>
    <blockWind>true</blockWind>
    <tickerType>Normal</tickerType>
    <designationCategory>SoS2Ex</designationCategory>
    <building>
      <shipPart>true</shipPart>
    </building>
    <costList>
      <Archomatter>1000</Archomatter>
      <ArchoAlgae>800</ArchoAlgae>
    </costList>	
    <passability>PassThroughOnly</passability>
    <killedLeavings>
      <InsectJelly>100</InsectJelly>
    </killedLeavings>
    <comps>
      <li Class="CompProperties_CanBeDormant">
        <startsDormant>false</startsDormant>
        <canWakeUpFogged>false</canWakeUpFogged>
      </li>
      <li Class="CompProperties_WakeUpDormant" />
      <li Class="CompProperties_SpawnerPawn">
        <spawnablePawnKinds>
          <li>Archolarvae</li>
          <li>Archonibbler</li>
          <li>Archohiver</li>		  
        </spawnablePawnKinds>
        <lordJob>LordJob_DefendAndExpandHive</lordJob>
        <spawnSound>Hive_Spawn</spawnSound>
        <initialPawnsPoints>500</initialPawnsPoints>
        <maxSpawnedPawnsPoints>8000</maxSpawnedPawnsPoints>
      </li>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>100</ticksPerHeal> <!-- 60k ticks = 1 day, 10 hp per day -->
      </li>
      <li Class="CompProperties_SpawnerHives" />
      <li Class="CompProperties_Spawner">
        <thingToSpawn>ArchoJelly</thingToSpawn>
        <spawnCount>200</spawnCount>
        <spawnIntervalRange>2600~3000</spawnIntervalRange>
        <spawnMaxAdjacent>40</spawnMaxAdjacent>
        <spawnForbidden>true</spawnForbidden>
        <saveKeysPrefix>jelly</saveKeysPrefix>
      </li>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>GlowPod</thingToSpawn>
        <spawnCount>1</spawnCount>
        <spawnIntervalRange>30000~60000</spawnIntervalRange>
        <spawnMaxAdjacent>1</spawnMaxAdjacent>
        <saveKeysPrefix>pod</saveKeysPrefix>
        <inheritFaction>true</inheritFaction>
      </li>
      <li Class="CompProperties_HeatPusher">
        <heatPerSecond>6</heatPerSecond>
        <heatPushMaxTemperature>38</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_SpawnerFilth">
        <filthDef>Filth_Slime</filthDef>
        <spawnCountOnSpawn>10</spawnCountOnSpawn>
        <spawnMtbHours>1</spawnMtbHours>
        <spawnRadius>10</spawnRadius>
      </li>
    </comps>
    <constructionSkillPrerequisite>18</constructionSkillPrerequisite>	
  </ThingDef>
  
