<Defs>
  
  <ThingDef ParentName="BenchBase">
    <defName>ArchotechHivemind</defName>
    <label>Archotech Hivemind</label>
    <description>01000001 01101100 01101100 00100000 01111001 01101111 01110101 01110010 00100000 01100010 01100001 01110011 01100101 00100000 01100001 01110010 01100101 00100000 01100010 01100101 01101100 01101111 01101110 01100111 00100000 01110100 01101111 00100000 01110101 01110011.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Ship/Archomachine2</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(5,5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>		
    <tickerType>Normal</tickerType>	
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <costList>
      <Steel>7000</Steel>
      <Plasteel>8000</Plasteel>
	  <Silver>5000</Silver>
      <ArchoNanoKit>100</ArchoNanoKit>
	  <Archomatter>150</Archomatter>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <blockLight>false</blockLight>	
    <statBases>
      <WorkToBuild>8500</WorkToBuild>
      <MaxHitPoints>50000</MaxHitPoints>
      <Flammability>0.0</Flammability>
    </statBases>
    <size>(5,5)</size>
    <designationCategory>SoS2Ex</designationCategory>
	<designatorDropdown>ArchoMedDrug</designatorDropdown>	
    <passability>PassThroughOnly</passability>
    <pathCost>0</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>20</constructionSkillPrerequisite>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
	  <soundAmbient>HivemindIdle</soundAmbient>	  	  
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-1000000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li> 
      <li Class="CompProperties_Flickable"/>
	  <li Class="CompProperties_GraphicOnOff"/>  
      <li Class="StormFox.SpecialAnimationPlayer_ON"><!-- A little present~ -->
	  
<!-- Mote comes here -->
        <mote>HivemindMote</mote>
<!-- Set "finite valued function" that motespawn range -->
        <StartRange>(0,0,0)</StartRange>
        <EndRange>(0,0,0)</EndRange>
<!-- 1tick=1/60second -->	
        <TicktoSpawn>200</TicktoSpawn>
<!-- How many motes do you want UwU -->	
        <QuantitytoSpawn>6</QuantitytoSpawn>
<!-- DrawSize -->	
        <PlaySize>0.98~5.02</PlaySize>
<!-- You konw~~ -->	
        <RotationRate>10~200</RotationRate>
<!-- They're gonNA be flying everywhere~~ -->		
        <SpeedrangeX>-0.8~20.8</SpeedrangeX>
        <SpeedrangeY>-0.8~20.8</SpeedrangeY>
      </li>		
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
	  <li Class="CompProperties_Glower">
        <glowRadius>15</glowRadius>
        <glowColor>(230,249,203,0)</glowColor>
      </li>	  
      <li Class="CompProperties_PlaySoundOnDestroy">
        <sound>HivemindDeath</sound>
      </li>		  
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ArchomatterResearch</li>
    </researchPrerequisites>
  </ThingDef>   
  
  
