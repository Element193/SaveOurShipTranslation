     <SoundDef>
    <defName>HivemindIdle</defName>
    <sustain>True</sustain> 	
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused> 	  
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Ship/HivemindIdle</clipPath>
          </li>
        </grains>
        <!--<pitchRange>0.2~0.8</pitchRange>-->
        <volumeRange>725~725</volumeRange>
      </li>
    </subSounds>
  </SoundDef>    
  
  <SoundDef>
    <defName>HivemindDeath</defName>
    <context>MapOnly</context>
