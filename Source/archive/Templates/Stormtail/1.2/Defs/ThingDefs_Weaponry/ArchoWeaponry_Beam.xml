  <ThingDef ParentName="VWEL_Bullet_LaserGeneric" Class="VanillaWeaponsExpandedLaser.LaserBeamDef">
    <defName>Archogun_BeamcanonBullet</defName>	
    <label>Archomatter Beam</label>
    <description>A focused, long range archomatter beam.</description>
    <textures>
      <li>Things/Projectile/Beambullet</li>
    </textures>
    <seam>0.1</seam>
    <causefireChance>0.2</causefireChance>
	<beamWidth>0.5</beamWidth>
