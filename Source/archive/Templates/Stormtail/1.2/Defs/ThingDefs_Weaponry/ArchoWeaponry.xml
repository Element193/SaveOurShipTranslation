<Defs>
  
  <ThingDef ParentName="SOSEXBaseWeapon">
    <defName>Archogun_AlgaeBeamer</defName>
    <label>Archomatter Blaster</label>    
	<description>A rather dangerous weapon that is meant to inject the target with Archomatter Nanites and activate a mutation process. It's also very effective against buildings!</description>
    <techLevel>Spacer</techLevel>
	<graphicData>
      <texPath>Things/Weapons/ArchobeamCanon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2)</drawSize>	  
    </graphicData>
    <soundInteract>Interact_ChargeLance</soundInteract>
    <statBases>
		<MarketValue>3600</MarketValue>	
      <WorkToMake>90000</WorkToMake>
      <Mass>2.5</Mass>
      <AccuracyTouch>.80</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>.95</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisites>
	    <li>ArchoWeaponry</li>	    
	  </researchPrerequisites>
      <skillRequirements>
        <Crafting>18</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="True">
        <li>ArchotechWorkbench</li>
      </recipeUsers>
    </recipeMaker>
	<thingSetMakerTags>
	  <li>RewardStandardLowFreq</li>
	  <li>RewardStandardQualitySuper</li>
	</thingSetMakerTags>
    <costList>
      <ArchoAlgae>550</ArchoAlgae>
	  <Archomatter>300</Archomatter>
      <ComponentSpacer>10</ComponentSpacer>
      <ComponentIndustrial>10</ComponentIndustrial>	  
    </costList>
        <generateCommonality>0.0001</generateCommonality>	
    <weaponTags>
	  <li>SOSEXBaseWeapon</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Archobeam</defaultProjectile>
		<forcedMissRadius>1.1</forcedMissRadius>		
        <warmupTime>1.3</warmupTime>
		<burstShotCount>5</burstShotCount>
		<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <range>80</range>
        <soundCast>ArchoBeamFire</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
		<extraMeleeDamages>
          <li>
            <def>Burn</def>
            <amount>3</amount>
            <chance>0.8</chance>
          </li>
        </extraMeleeDamages>
      </li>
    </tools>	
  </ThingDef> 
  
