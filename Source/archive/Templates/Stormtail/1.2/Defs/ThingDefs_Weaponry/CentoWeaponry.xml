<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <ThingDef ParentName="SOSEXBaseWeapon">
    <defName>CentoBlaster</defName>
    <label>Cento Blaster</label>    
	<description>Exil.</description>
    <techLevel>Archotech</techLevel>
	<graphicData>
      <texPath>Things/Weapons/CentoBlaster</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2)</drawSize>	  
    </graphicData>
    <soundInteract>Interact_ChargeLance</soundInteract>
    <statBases>
		<MarketValue>7000</MarketValue>	
      <WorkToMake>90000</WorkToMake>
      <Mass>2.5</Mass>
      <AccuracyTouch>.90</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1.95</AccuracyLong>
      <RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisites>
	    <li>ArchomatterAscension</li>	    
	  </researchPrerequisites>
      <skillRequirements>
        <Crafting>20</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="True">
        <li>AscendedArchotechWorkbench</li>
      </recipeUsers>
    </recipeMaker>
	<thingSetMakerTags>
	  <li>RewardStandardLowFreq</li>
	  <li>RewardStandardQualitySuper</li>
	</thingSetMakerTags>
    <costList>
	  <Centomatter>300</Centomatter>
      <ComponentSpacer>10</ComponentSpacer>
      <ComponentIndustrial>10</ComponentIndustrial>	  
    </costList>
        <generateCommonality>0.0001</generateCommonality>		
    <weaponTags>
	  <li>SOSEXQuality</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CentoBlasterBullet</defaultProjectile>
		<forcedMissRadius>0.5</forcedMissRadius>		
        <warmupTime>1.3</warmupTime>
		<burstShotCount>1</burstShotCount>
		<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <range>100</range>
        <soundCast>CentoBlaster</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
			<!--<muzzleFlashScale>0</muzzleFlashScale>-->
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
		<extraMeleeDamages>
          <li>
            <def>Burn</def>
            <amount>8</amount>
            <chance>0.8</chance>
          </li>
        </extraMeleeDamages>
      </li>
    </tools>	
  </ThingDef> 
  
     <ThingDef ParentName="BaseBullet">
    <defName>CentoBlasterBullet</defName>
    <graphicData>
      <texPath>Things/Projectile/CentoBlasterBullet</texPath>
      <graphicClass>Graphic_Single</graphicClass>	  
      <shaderType>MoteGlow</shaderType>
	       <drawSize>2.0</drawSize>	  
    </graphicData>
	<thingClass>Projectile_Explosive</thingClass>	
    <projectile>
      <damageDef>CentoBlasterDMG</damageDef> 
	  <stoppingPower>10</stoppingPower>
	  <explosionRadius>8</explosionRadius>	  
	  <damageAmountBase>100</damageAmountBase>
	  <armorPenetrationBase>10.80</armorPenetrationBase>
      <speed>45</speed>
    </projectile>	
    <drawOffscreen>true</drawOffscreen>	
    <mote>
      <!--<fadeInTime>0</fadeInTime>-->
      <solidTime>3.25</solidTime>
      <fadeOutTime>2.25</fadeOutTime>
      <growthRate>7.40</growthRate>	  
    </mote>
	<seeThroughFog>true</seeThroughFog>
  </ThingDef>
  
  <DamageDef ParentName="BluntBase">
    <defName>CentoBlasterDMG</defName>
    <label>Archobeam</label>
    <workerClass>SOS2_EX.Damage.DamageWorker_ArchotechBurn</workerClass>	
	<deathMessage>{0} has been mutated to death.</deathMessage>
	<isRanged>true</isRanged>
	<bluntStunDuration>5.8</bluntStunDuration>
	<explosionCellMote>CentoBlasterMote</explosionCellMote>	
	<soundExplosion>ArchoBeamExplosion</soundExplosion>
	<buildingDamageFactor>10.70</buildingDamageFactor>
  </DamageDef> 

     <ThingDef ParentName="MoteBase">
    <defName>CentoBlasterMote</defName>
    <graphicData>
      <texPath>Things/Mote/WorldEnderParticles</texPath>
      <shaderType>MoteGlow</shaderType>
	       <drawSize>2.2</drawSize>	  
    </graphicData>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>	
    <mote>
      <fadeInTime>0</fadeInTime>
      <solidTime>0.05</solidTime>
      <fadeOutTime>0.05</fadeOutTime>
      <growthRate>1.40</growthRate>	  
    </mote>
	<seeThroughFog>true</seeThroughFog>
  </ThingDef>    

     	<SoundDef>
    <defName>CentoBlaster</defName>	
    <context>MapOnly</context>
    <maxSimultaneous>10</maxSimultaneous>	
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused> 	  
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Ship/CentoBlaster</clipPath>
          </li>
        </grains>
        <!--<pitchRange>0.2~0.8</pitchRange>-->
        <volumeRange>525~525</volumeRange>
      </li>
    </subSounds>
  </SoundDef> 
  
  
</Defs>