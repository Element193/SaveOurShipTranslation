<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--Class="CulturedMeat.MeatPlant"-->
	
  <ThingDef Name="CMeatBase" Abstract="True" >
    <category>Plant</category>
    <thingClass>CulturedMeat.MeatPlant</thingClass>
    <altitudeLayer>LowPlant</altitudeLayer>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <Flammability>0.5</Flammability>
    </statBases>
    <tickerType>Long</tickerType>
    <selectable>True</selectable>
    <neverMultiSelect>True</neverMultiSelect>
    <drawerType>MapMeshOnly</drawerType>
    <pathCostIgnoreRepeat>false</pathCostIgnoreRepeat>
    <graphicData>
			<graphicClass>Graphic_Random</graphicClass>
			<shaderType>CutoutPlant</shaderType>
    </graphicData>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>RawBad</preferability>
	</ingestible>
    <plant>
		<growMinGlow>0</growMinGlow>
		<growOptimalGlow>0</growOptimalGlow>
		<fertilityMin>0.5</fertilityMin>
		<fertilitySensitivity>1.0</fertilitySensitivity>
		<sowTags>
			<li>MeatLab_tag</li>
		</sowTags>
		<soundHarvesting>Harvest_Standard</soundHarvesting>
		<soundHarvestFinish>Harvest_Standard_Finish</soundHarvestFinish>
		<neverBlightable>true</neverBlightable>
		<sowWork>200</sowWork>
		<harvestWork>250</harvestWork>
		<topWindExposure>0</topWindExposure>
		<wildClusterRadius>0</wildClusterRadius>
		<wildClusterWeight>0</wildClusterWeight>
		<visualSizeRange>
			<min>0.3</min>
			<max>0.8</max>
		</visualSizeRange>
		<purpose>Food</purpose>
    </plant>
  </ThingDef>

  <!--=========================== Food crops ==============================-->

	<ThingDef ParentName="CMeatBase">
		<defName>CMeatChicken</defName>
		<label>Cultivate Chicken</label>
		<description>A lump of chicken meat. Quick growth speed and below moderate yield value.</description>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Nutrition>0.10</Nutrition>
		</statBases>
		<graphicData>
			<texPath>Things/Material/CMeatSmall_Growing</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<pathCost>10</pathCost>
		<ingestible />
		<plant>
			<dieIfLeafless>true</dieIfLeafless>
			<maxMeshCount>4</maxMeshCount>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>RawChickenMeat</harvestedThingDef>
			<harvestYield>12</harvestYield>
			<growDays>2</growDays>
		</plant>
	</ThingDef>

	<ThingDef ParentName="CMeatBase">
		<defName>CMeatPig</defName>
		<label>Cultivate Pork</label>
		<description>A lump of pig meat. Average growth speed and moderate yield value.</description>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Nutrition>0.15</Nutrition>
		</statBases>
		<graphicData>
			<texPath>Things/Material/CMeatBig_Growing</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<pathCost>10</pathCost>
		<ingestible />
		<plant>
			<dieIfLeafless>true</dieIfLeafless>
			<maxMeshCount>4</maxMeshCount>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>RawPigMeat</harvestedThingDef>
			<harvestYield>17</harvestYield>
			<growDays>3</growDays>
		</plant>
	</ThingDef>

	<ThingDef ParentName="CMeatBase">
		<defName>CMeatBeef</defName>
		<label>Cultivate Beef</label>
		<description>A lump of cow meat. Long growth speed and high yield value.</description>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Nutrition>0.20</Nutrition>
		</statBases>
		<graphicData>
			<texPath>Things/Material/CMeatBig_Growing</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<pathCost>10</pathCost>
		<ingestible />
		<plant>
			<dieIfLeafless>true</dieIfLeafless>
			<maxMeshCount>4</maxMeshCount>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>RawCowMeat</harvestedThingDef>
			<harvestYield>22</harvestYield>
			<growDays>4</growDays>
		</plant>
	</ThingDef>

</Defs>
