<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ======================= Meat Lab ======================= -->
  
  <ThingDef ParentName="BuildingBase">
    <defName>MeatLab</defName>
    <label>meat lab</label>
    <description>Grows meat quickly in an artificial nutrient bath. Requires power to work; meat will die if power is cut.</description>
    <thingClass>Building_PlantGrower</thingClass>
    <graphicData>
      <texPath>Things/Building/Ship/MeatLab</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <castEdgeShadows>true</castEdgeShadows>
    <constructEffect>ConstructMetal</constructEffect>
    <fillPercent>1.0</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <constructionSkillPrerequisite>15</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>3500</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-3</Cleanliness>
    </statBases>
    <size>(1,2)</size>
    <costList>
      <Steel>100</Steel>
      <Plasteel>25</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <fertility>7.0</fertility>
    <building>
      <defaultPlantToGrow>CMeatChicken</defaultPlantToGrow>
      <sowTag>MeatLab_tag</sowTag>
    </building>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <researchPrerequisites><li>SpaceMeat</li></researchPrerequisites>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>SoS2Ex</designationCategory>
  </ThingDef>
  
  
  
</Defs>