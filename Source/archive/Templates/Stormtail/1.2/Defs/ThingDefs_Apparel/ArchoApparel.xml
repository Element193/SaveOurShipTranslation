<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="SOSEXApparel">
    <defName>AArchoHelmet</defName>
    <label>A.R.C.H.O Helmet</label>
    <description>Archomatter helmet with a reflective ArchoAlgae layer.</description>	
    <techLevel>Archotech</techLevel>
	<useHitPoints>true</useHitPoints>
    <tickerType>Normal</tickerType>	
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisite>ArchoWeaponry</researchPrerequisite>	  
      <skillRequirements>
        <Crafting>18</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>ArchotechWorkbench</li>
      </recipeUsers>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Apparel/ArchoHelmet/ArchoHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.25</uiIconScale>
    <selectable>true</selectable>
	<thingCategories>
      <li>SOSEXApparel</li>
    </thingCategories>
    <generateCommonality>0.0001</generateCommonality>
    <statBases>
      <MarketValue>25000</MarketValue>	
      <WorkToMake>80000</WorkToMake>
      <MaxHitPoints>10000</MaxHitPoints>
	  <DeteriorationRate>0.0</DeteriorationRate>
      <Mass>0.75</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>5</ArmorRating_Sharp>
      <ArmorRating_Blunt>5</ArmorRating_Blunt>
      <ArmorRating_Heat>25</ArmorRating_Heat>
      <Insulation_Cold>150</Insulation_Cold>
      <Insulation_Heat>150</Insulation_Heat>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <costList>
      <Archomatter>2500</Archomatter>
      <ArchoAlgae>1500</ArchoAlgae>	  
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/ArchoHelmet/ArchoHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
	  <tags>
		<li>EVA</li>
        <li>SOSEXApparelQuality</li>		
	  </tags>  
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
    <comps>
      <li Class="CompProperties_BiocodableApparel"/>
    </comps>		
  </ThingDef>
  
