<!--Makes Tool Cabinets work with any workbench from any mod as long as it has vanilla Tool Cabinet linked-->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef/comps/li[@Class='CompProperties_AffectedByFacilities']/linkableFacilities[li = 'ToolCabinet']</xpath>
			<value>
				<li>ArchoTool</li>
			</value>
	</Operation>
<!--Pinnable-->	<!-- Unobtainer	-->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Science Never Stops: You're Going Too Far</li>
			<li>Science Never Stops: Ambition of the Cosmic</li>
		</mods>
		<match Class="PatchOperationSequence">
		<success>Normal</success>
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="Table_SNS_PinnacleFabricator" or defName="Table_SNS_Unobtainer"]/comps</xpath>
					<value>
						<li Class="CompProperties_AffectedByFacilities">
							<linkableFacilities>
								<li>ArchoTool</li>
							</linkableFacilities>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>