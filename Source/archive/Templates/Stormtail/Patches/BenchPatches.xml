<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!--Electric Smelter-->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="ElectricSmelter"]/comps</xpath>
			<value>
				<li Class="CompProperties_AffectedByFacilities">
					<linkableFacilities>
						<li>ArchoTool</li>
					</linkableFacilities>
				</li>
			</value>
	</Operation>	
